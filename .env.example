SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clfis_db
CAMPUS_EMAIL_DOMAIN=college.edu

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ML
SIGLIP_MODEL=google/siglip-base-patch16-224

# Hugging Face token, required only for gated weights (e.g. DINOv3).
# Copy this file to .env and put the real token there -- .env is gitignored.
# Use a fine-grained, READ-ONLY token; it never needs write access.
HF_TOKEN=
